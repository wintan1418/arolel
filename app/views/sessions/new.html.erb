<section style="max-width: 420px; margin: 40px auto 0;">
  <div class="tb-eyebrow">Sign in</div>
  <h1 class="tb-h1 tb-tool-title" style="margin-top: 10px;">Welcome back.</h1>
  <p class="tb-text" style="margin-top: 10px;">
    An account is only needed to save things to your dashboard. Every free tool works signed-out too.
  </p>

  <%= form_with url: session_path, class: "tb-stack-14", style: "margin-top: 24px;", local: true do |f| %>
    <div>
      <%= f.label :email_address, "Email", class: "tb-field-label", for: "session-email" %>
      <%= f.email_field :email_address, id: "session-email", required: true, autofocus: true, autocomplete: "username", inputmode: "email", class: "tb-input", placeholder: "you@example.com", value: params[:email_address] %>
    </div>
    <div>
      <%= f.label :password, "Password", class: "tb-field-label", for: "session-password" %>
      <%= f.password_field :password, id: "session-password", required: true, autocomplete: "current-password", class: "tb-input", maxlength: 72 %>
    </div>
    <div class="tb-actions-inline">
      <%= f.submit "Sign in", class: "tb-btn tb-btn-primary tb-btn-lg" %>
      <%= link_to "Forgot password?", new_password_path, class: "tb-btn tb-btn-quiet" %>
    </div>
  <% end %>

  <div class="tb-text-sm" style="margin-top: 28px; padding-top: 18px; border-top: 1px dashed var(--tb-line);">
    New here? <%= link_to "Sign up", signup_path(return_to: params[:return_to]), style: "color: var(--tb-red); text-decoration: underline;" %>
  </div>
</section>
