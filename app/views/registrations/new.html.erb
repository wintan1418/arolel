<section style="max-width: 440px; margin: 40px auto 0;">
  <div class="tb-eyebrow">Sign up</div>
  <h1 class="tb-h1 tb-tool-title" style="margin-top: 10px;">Free account.</h1>
  <p class="tb-text" style="margin-top: 10px;">
    Accounts are optional. The tools work without one. Signing up gives you a dashboard
    to keep saved contracts, invoices, boards, URL sets and reusable signatures in one place.
  </p>
  <p class="tb-text-sm tb-muted" style="margin-top: 8px;">
    We don't send marketing email. Ever.
  </p>

  <%= form_with model: @user, url: registration_path, class: "tb-stack-14", style: "margin-top: 24px;", local: true do |f| %>
    <% if @user.errors.any? %>
      <div class="tb-flash tb-flash-alert" role="alert" style="margin-bottom: 0;">
        <div>
          <strong>Please fix the following:</strong>
          <ul>
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <div>
      <%= f.label :email_address, "Email", class: "tb-field-label", for: "signup-email" %>
      <%= f.email_field :email_address, id: "signup-email", required: true, autofocus: true, autocomplete: "username", inputmode: "email", class: "tb-input", placeholder: "you@example.com" %>
    </div>
    <div>
      <%= f.label :password, "Password", class: "tb-field-label", for: "signup-password" %>
      <%= f.password_field :password, id: "signup-password", required: true, autocomplete: "new-password", class: "tb-input", minlength: 8, maxlength: 72, "aria-describedby": "signup-password-hint" %>
      <div id="signup-password-hint" class="tb-text-sm tb-muted" style="margin-top: 6px;">At least 8 characters.</div>
    </div>
    <div>
      <%= f.label :password_confirmation, "Confirm password", class: "tb-field-label", for: "signup-password-confirmation" %>
      <%= f.password_field :password_confirmation, id: "signup-password-confirmation", required: true, autocomplete: "new-password", class: "tb-input", minlength: 8, maxlength: 72 %>
    </div>

    <%= f.submit "Sign up", class: "tb-btn tb-btn-primary tb-btn-lg" %>
  <% end %>

  <div class="tb-text-sm" style="margin-top: 28px; padding-top: 18px; border-top: 1px dashed var(--tb-line);">
    Already have one? <%= link_to "Sign in", new_session_path(return_to: params[:return_to]), style: "color: var(--tb-red); text-decoration: underline;" %>
  </div>
</section>
